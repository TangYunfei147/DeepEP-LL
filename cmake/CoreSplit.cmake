# Shared by Host and direct Device configuration.
set(DEEPEP_LL_SEND_CORES 28 CACHE STRING "LL sender AIV count")
set(DEEPEP_LL_RECV_CORES 28 CACHE STRING "LL receiver AIV count")
set(DEEPEP_LL_SMALL_B_PREFIX_CORES 0 CACHE STRING "EP16 small direct prefix producers; 0 uses all receive cores")
set(DEEPEP_LL_DISPATCH_IMPL current CACHE STRING "LL dispatch implementation: current, cb59, cb59-stream, cb59-pair or cb59-small")
set_property(CACHE DEEPEP_LL_DISPATCH_IMPL PROPERTY STRINGS current cb59 cb59-stream cb59-pair cb59-small)
if(NOT DEEPEP_LL_DISPATCH_IMPL STREQUAL "current" AND NOT DEEPEP_LL_DISPATCH_IMPL STREQUAL "cb59"
   AND NOT DEEPEP_LL_DISPATCH_IMPL STREQUAL "cb59-stream" AND NOT DEEPEP_LL_DISPATCH_IMPL STREQUAL "cb59-pair"
   AND NOT DEEPEP_LL_DISPATCH_IMPL STREQUAL "cb59-small")
    message(FATAL_ERROR "DEEPEP_LL_DISPATCH_IMPL must be current, cb59, cb59-stream, cb59-pair or cb59-small")
endif()
foreach(_key DEEPEP_LL_SEND_CORES DEEPEP_LL_RECV_CORES)
    if(NOT "${${_key}}" MATCHES "^[1-9][0-9]*$")
        message(FATAL_ERROR "${_key} must be a positive integer")
    endif()
endforeach()
math(EXPR _ll_total "${DEEPEP_LL_SEND_CORES}+${DEEPEP_LL_RECV_CORES}")
if(NOT _ll_total EQUAL 56)
    message(FATAL_ERROR "LL send + receive cores must equal 56")
endif()
if(NOT "${DEEPEP_LL_SMALL_B_PREFIX_CORES}" MATCHES "^(0|[1-9][0-9]?)$"
   OR DEEPEP_LL_SMALL_B_PREFIX_CORES GREATER DEEPEP_LL_RECV_CORES)
    message(FATAL_ERROR "DEEPEP_LL_SMALL_B_PREFIX_CORES must be 0 or an integer in 1..DEEPEP_LL_RECV_CORES")
endif()
set(DEEPEP_LL_DISPATCH_CB59 0)
if(NOT DEEPEP_LL_DISPATCH_IMPL STREQUAL "current")
    if(NOT DEEPEP_LL_SEND_CORES EQUAL 28 OR NOT DEEPEP_LL_RECV_CORES EQUAL 28
       OR NOT DEEPEP_LL_SMALL_B_PREFIX_CORES EQUAL 0)
        message(FATAL_ERROR "${DEEPEP_LL_DISPATCH_IMPL} requires SEND_CORES=28, RECV_CORES=28 and SMALL_B_PREFIX_CORES=0")
    endif()
    set(DEEPEP_LL_DISPATCH_CB59 1)
    if(DEEPEP_LL_DISPATCH_IMPL STREQUAL "cb59-stream")
        set(DEEPEP_LL_DISPATCH_CB59 2)
    elseif(DEEPEP_LL_DISPATCH_IMPL STREQUAL "cb59-pair")
        set(DEEPEP_LL_DISPATCH_CB59 3)
    elseif(DEEPEP_LL_DISPATCH_IMPL STREQUAL "cb59-small")
        set(DEEPEP_LL_DISPATCH_CB59 4)
    endif()
endif()
add_compile_definitions(DEEPEP_LL_SEND_CORES=${DEEPEP_LL_SEND_CORES} DEEPEP_LL_RECV_CORES=${DEEPEP_LL_RECV_CORES}
    DEEPEP_LL_SMALL_B_PREFIX_CORES=${DEEPEP_LL_SMALL_B_PREFIX_CORES}
    DEEPEP_LL_DISPATCH_CB59=${DEEPEP_LL_DISPATCH_CB59})
